{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/whatsapp"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-colabs",
      "schedule": "0 * * * *"
    }
  ]
}
